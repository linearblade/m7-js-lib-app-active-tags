{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m7.org/schemas/activetags/pipeline.schema.v1.json",
  "title": "ActiveTags Pipeline Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipelines"],
  "properties": {
    "pipelines": {
      "type": "object",
      "description": "Map of pipeline name -> pipeline block.",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/PipelineBlock" }
    }
  },
  "$defs": {
    "PipelineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "src": { "$ref": "#/$defs/TargetRef" },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PipelineOp" }
        },
        "dst": { "$ref": "#/$defs/TargetRef" },
        "onError": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PipelineOp" }
        },
        "onErrorMode": {
          "type": "string",
          "enum": ["block", "continue"],
          "default": "block",
          "description": "block = stop pipeline after onError; continue = continue after onError."
        },
        "meta": {
          "type": "object",
          "description": "Optional metadata for debugging/tracing (ignored by engine).",
          "additionalProperties": true
        }
      }
    },

    "TargetRef": {
      "description": "Reference to a value source/target. Either 'type:path' string or structured object.",
      "oneOf": [
        { "$ref": "#/$defs/TargetRefString" },
        { "$ref": "#/$defs/TargetRefObject" }
      ]
    },
    "TargetRefString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*:(.*)?$"
    },
    "TargetRefObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "path": { "type": "string" }
      }
    },

    "PipelineOp": {
      "description": "A single builtin operation in a pipeline.",
      "oneOf": [
        { "$ref": "#/$defs/OpUiConfirm" },
        { "$ref": "#/$defs/OpRequestSubmit" },
        { "$ref": "#/$defs/OpResponseJson" },
        { "$ref": "#/$defs/OpResponseText" },
        { "$ref": "#/$defs/OpResponseAssert" },
        { "$ref": "#/$defs/OpUiAlert" },
        { "$ref": "#/$defs/OpBufferRead" },
        { "$ref": "#/$defs/OpBufferWrite" },
        { "$ref": "#/$defs/OpBufferTraverse" },
        { "$ref": "#/$defs/OpAttrTransform" },
        { "$ref": "#/$defs/OpCall" },
        { "$ref": "#/$defs/OpPipelineRun" }
      ]
    },

    "OpBase": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "type": "string" }
      }
    },

    "OpUiConfirm": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "ui.confirm" },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["op", "message"]
        }
      ]
    },

    "OpRequestSubmit": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "request.submit" },
            "request": { "$ref": "#/$defs/RequestSpec" }
          },
          "required": ["op"]
        }
      ]
    },

    "RequestSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "encoding": {
          "type": "string",
          "enum": ["urlencoded", "json", "formdata", "raw"]
        },
        "body": {
          "description": "String, object, pairs, or FormData-like (serialized by engine based on encoding).",
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true },
            {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [{ "type": "string" }, {}]
              }
            }
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "credentials": { "type": "boolean" },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urlencoded": { "type": "boolean" },
            "json": { "type": "boolean" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "transport": { "type": "string", "minLength": 1 }
      }
    },

    "OpResponseJson": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "response.json" },
            "from": { "$ref": "#/$defs/TargetRef" }
          },
          "required": ["op"]
        }
      ]
    },

    "OpResponseText": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "response.text" },
            "from": { "$ref": "#/$defs/TargetRef" }
          },
          "required": ["op"]
        }
      ]
    },

    "OpResponseAssert": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "response.assert" },
            "ok": { "type": "boolean", "default": true },
            "status": {
              "oneOf": [
                { "type": "integer" },
                { "type": "array", "minItems": 1, "items": { "type": "integer" } }
              ]
            }
          },
          "required": ["op"]
        }
      ]
    },

    "OpUiAlert": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "ui.alert" },
            "mode": { "type": "string", "enum": ["clear", "buffer"] },
            "target": { "$ref": "#/$defs/TargetRef" }
          },
          "required": ["op"]
        }
      ]
    },

    "OpBufferRead": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "buffer.read" },
            "from": { "$ref": "#/$defs/TargetRef" }
          },
          "required": ["op", "from"]
        }
      ]
    },

    "OpBufferWrite": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "buffer.write" },
            "to": { "$ref": "#/$defs/TargetRef" }
          },
          "required": ["op", "to"]
        }
      ]
    },

    "OpBufferTraverse": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "buffer.traverse" },
            "path": { "type": "string", "minLength": 1 }
          },
          "required": ["op", "path"]
        }
      ]
    },

    "OpAttrTransform": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "attr.transform" },
            "map": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string" }
            }
          },
          "required": ["op", "map"]
        }
      ]
    },

    "OpCall": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "call" },
            "name": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": {} }
          },
          "required": ["op", "name"]
        }
      ]
    },

    "OpPipelineRun": {
      "allOf": [
        { "$ref": "#/$defs/OpBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": { "const": "pipeline.run" },
            "name": { "type": "string", "minLength": 1 }
          },
          "required": ["op", "name"]
        }
      ]
    }
  }
}
